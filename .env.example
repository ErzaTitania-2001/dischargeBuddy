# DischargeBuddy AI Healthcare Companion
# Keep this file secure and never commit real API keys to version control.

# Meta Model API key (https://dev.meta.ai/)
MODEL_API_KEY=

# Muse Spark model selection
MODEL_NAME=muse-spark-1.3
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Durable storage. Leave DATABASE_URL empty for local SQLite development.
DATA_DIR=./data
DATABASE_PATH=./data/dischargebuddy.sqlite3
DATABASE_URL=
UPLOAD_DIR=./data/uploads
STORAGE_BUCKET=
MAX_UPLOAD_BYTES=20971520
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
EMERGENCY_NUMBER=911

# Brevo transactional email (never expose the API key in frontend code)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DischargeBuddy
EMAIL_NOTIFICATIONS_ENABLED=false
APP_BASE_URL=http://localhost:8080
SCHEDULER_SERVICE_ACCOUNT_EMAIL=

# Server Configuration
PORT=8080
HOST=0.0.0.0
